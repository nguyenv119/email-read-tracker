{
  "name": "@mailtrack/infra",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pulumi": "AWS_PROFILE=mail-tracker PULUMI_CONFIG_PASSPHRASE='' pulumi",
    "deploy": "npm --prefix .. run build && npm run pulumi -- up",
    "preview": "npm run pulumi -- preview",
    "destroy": "npm run pulumi -- destroy"
  },
  "dependencies": {
    "@pulumi/aws": "^6.0.0",
    "@pulumi/pulumi": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
